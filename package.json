{
    "name": "easynat",
    "version": "1.0.0",
    "description": "Componentes de React Native listos para usar: tema claro y oscuro, formularios con validación, gráficos, tablas, editor de imágenes, visor de PDF y más. / Ready-to-use React Native UI components.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "react-native": "dist/index.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:pdfjs": "node scripts/build-pdfjs.js",
        "pack:check": "npm pack --dry-run",
        "prepublishOnly": "npm run typecheck && npm run build",
        "test": "tsc -p tests/tsconfig.json && node tests/run.js"
    },
    "keywords": [
        "react-native",
        "expo",
        "ui",
        "components",
        "component-library",
        "theme",
        "dark-mode",
        "forms",
        "validation",
        "charts",
        "table",
        "slider",
        "select",
        "date-picker",
        "image-editor",
        "pdf-viewer",
        "easynat"
    ],
    "author": "JESUS RUIZ",
    "license": "MIT",
    "homepage": "https://easynat.web.app",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cirilojesus/easynat.git"
    },
    "bugs": {
        "url": "https://github.com/cirilojesus/easynat/issues"
    },
    "peerDependencies": {
        "react": ">=18.2.0",
        "react-native": ">=0.72.0",
        "react-native-reanimated": ">=3.3.0",
        "react-native-svg": ">=13.0.0",
        "react-native-safe-area-context": ">=4.5.0",
        "react-native-root-siblings": ">=4.1.0",
        "@react-native-async-storage/async-storage": ">=1.17.0",
        "@expo/vector-icons": ">=13.0.0",
        "react-native-webview": ">=11.0.0"
    },
    "peerDependenciesMeta": {
        "react-native-webview": {
            "optional": true
        }
    },
    "devDependencies": {
        "@expo/vector-icons": "^15.0.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@types/react": "^19.2.18",
        "linkedom": "^0.18.13",
        "react": "^19.2.3",
        "react-native": "^0.86.3",
        "react-native-reanimated": "^4.5.1",
        "react-native-root-siblings": "^5.0.1",
        "react-native-safe-area-context": "^5.7.0",
        "react-native-svg": "^15.15.4",
        "react-native-webview": "^13.16.1",
        "react-native-worklets": "^0.10.1",
        "react-test-renderer": "^19.2.3",
        "typescript": "^6.0.3"
    }
}
